{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "resource.schema.json",
  "title": "Registry resource",
  "description": "One API, dataset or MCP server. Generated from vocab/ by registry_kit; do not edit.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "kind",
    "name",
    "url",
    "description",
    "domain",
    "license",
    "provenance"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "kind": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "api",
          "dataset",
          "mcp-server"
        ]
      }
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^\\S(.*\\S)?$"
    },
    "url": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^https?://[^\\s/?#.][^\\s]*$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^\\S(.*\\S)?$"
    },
    "domain": {
      "enum": [
        "animals",
        "anime",
        "art-design",
        "blockchain-crypto",
        "books",
        "business",
        "calendar-events",
        "cloud-storage",
        "communication",
        "currency-exchange",
        "data-validation",
        "development",
        "documents-productivity",
        "economics",
        "education",
        "energy",
        "entertainment",
        "environment",
        "finance",
        "food-agriculture",
        "games",
        "geography",
        "government",
        "health",
        "images",
        "jobs",
        "language",
        "life-sciences",
        "machine-learning",
        "music",
        "networks",
        "news-media",
        "open-data",
        "science-math",
        "security",
        "shopping",
        "social",
        "social-sciences",
        "sports",
        "test-data",
        "transportation",
        "url-shorteners",
        "vehicles",
        "video",
        "weather-climate"
      ]
    },
    "tags": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9+.-]{0,29}$"
      }
    },
    "license": {
      "enum": [
        "AGPL-3.0-only",
        "Apache-2.0",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "C-UDA-1.0",
        "CC-BY-2.0",
        "CC-BY-2.5",
        "CC-BY-3.0",
        "CC-BY-3.0-IGO",
        "CC-BY-4.0",
        "CC-BY-NC-2.0",
        "CC-BY-NC-3.0",
        "CC-BY-NC-4.0",
        "CC-BY-NC-ND-3.0",
        "CC-BY-NC-ND-3.0-IGO",
        "CC-BY-NC-ND-4.0",
        "CC-BY-NC-SA-2.0",
        "CC-BY-NC-SA-3.0",
        "CC-BY-NC-SA-3.0-IGO",
        "CC-BY-NC-SA-4.0",
        "CC-BY-ND-3.0",
        "CC-BY-ND-4.0",
        "CC-BY-SA-2.0",
        "CC-BY-SA-3.0",
        "CC-BY-SA-3.0-IGO",
        "CC-BY-SA-4.0",
        "CC-PDDC",
        "CC0-1.0",
        "CDLA-Permissive-1.0",
        "CDLA-Permissive-2.0",
        "CDLA-Sharing-1.0",
        "DL-DE-BY-2.0",
        "DL-DE-ZERO-2.0",
        "GFDL-1.3-or-later",
        "GPL-2.0-only",
        "GPL-2.0-or-later",
        "GPL-3.0-only",
        "GPL-3.0-or-later",
        "ISC",
        "LGPL-3.0-only",
        "LicenseRef-Custom-Open",
        "LicenseRef-Open-Government",
        "LicenseRef-Provider-Terms",
        "LicenseRef-Public-Domain",
        "LicenseRef-Research-Only",
        "LicenseRef-US-Government-Work",
        "MIT",
        "MPL-2.0",
        "NIST-PD",
        "NLOD-1.0",
        "NLOD-2.0",
        "O-UDA-1.0",
        "ODC-By-1.0",
        "ODbL-1.0",
        "OGDL-Taiwan-1.0",
        "OGL-Canada-2.0",
        "OGL-UK-2.0",
        "OGL-UK-3.0",
        "PDDL-1.0",
        "Unlicense",
        "etalab-2.0",
        "unknown"
      ]
    },
    "license_url": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^https?://[^\\s/?#.][^\\s]*$"
    },
    "publisher": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "kind": {
          "enum": [
            "government",
            "intergovernmental",
            "academic",
            "nonprofit",
            "company",
            "community",
            "individual"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "added",
        "origin"
      ],
      "properties": {
        "added": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "origin": {
          "enum": [
            "public-apis",
            "apd-link",
            "contribution"
          ]
        },
        "reviewed": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "sponsored": {
          "type": "boolean"
        }
      }
    },
    "api": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth",
        "https",
        "cors"
      ],
      "properties": {
        "auth": {
          "enum": [
            "none",
            "api-key",
            "oauth",
            "user-agent",
            "x-mashape-key"
          ]
        },
        "https": {
          "type": "boolean"
        },
        "cors": {
          "enum": [
            "yes",
            "no",
            "unknown"
          ]
        },
        "docs": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^https?://[^\\s/?#.][^\\s]*$"
        },
        "spec": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^https?://[^\\s/?#.][^\\s]*$"
        }
      }
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "auth",
        "transport"
      ],
      "properties": {
        "auth": {
          "enum": [
            "none",
            "api-key",
            "oauth",
            "user-agent",
            "x-mashape-key"
          ]
        },
        "transport": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "stdio",
              "http",
              "sse"
            ]
          }
        },
        "install": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "url"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "url": {
                "type": "string",
                "maxLength": 500,
                "pattern": "^https?://[^\\s/?#.][^\\s]*$"
              }
            }
          }
        }
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formats",
        "access"
      ],
      "properties": {
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "archive",
              "arrow",
              "audio",
              "avro",
              "bam",
              "bed",
              "bibtex",
              "binary",
              "csv",
              "dbf",
              "dicom",
              "edf",
              "fasta",
              "fastq",
              "fits",
              "geojson",
              "geotiff",
              "gml",
              "gpkg",
              "grib",
              "gtfs",
              "hdf5",
              "html",
              "image",
              "json",
              "jsonl",
              "kml",
              "las",
              "marc",
              "matlab",
              "model-3d",
              "netcdf",
              "nifti",
              "numpy",
              "ods",
              "orc",
              "osm",
              "other",
              "parquet",
              "pdb",
              "pdf",
              "protobuf",
              "rdata",
              "rdf",
              "root",
              "sas",
              "sdmx",
              "shapefile",
              "spss",
              "sql",
              "sqlite",
              "stata",
              "text",
              "tsv",
              "vcf",
              "video",
              "warc",
              "xbrl",
              "xls",
              "xlsx",
              "xml",
              "yaml",
              "zarr"
            ]
          }
        },
        "access": {
          "enum": [
            "public",
            "registration",
            "application",
            "paid-tier"
          ]
        },
        "url": {
          "type": "string",
          "maxLength": 500,
          "pattern": "^https?://[^\\s/?#.][^\\s]*$"
        },
        "temporal": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "start": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            },
            "end": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^\\d{4}(-\\d{2}(-\\d{2})?)?$"
            }
          }
        },
        "spatial": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(global|africa|asia|europe|north-america|south-america|oceania|antarctica|arctic|[A-Z]{2}(-[A-Z0-9]{1,3})?)$"
          }
        },
        "update_frequency": {
          "enum": [
            "realtime",
            "daily",
            "weekly",
            "monthly",
            "quarterly",
            "annual",
            "irregular",
            "static"
          ]
        },
        "size": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        }
      }
    },
    "archived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "reason"
      ],
      "properties": {
        "date": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "not": {
          "required": [
            "archived"
          ]
        }
      },
      "then": {
        "properties": {
          "description": {
            "minLength": 10
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "contains": {
              "const": "api"
            }
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "api"
        ]
      },
      "else": {
        "not": {
          "required": [
            "api"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "contains": {
              "const": "dataset"
            }
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "dataset"
        ]
      },
      "else": {
        "not": {
          "required": [
            "dataset"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "contains": {
              "const": "mcp-server"
            }
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "mcp"
        ]
      },
      "else": {
        "not": {
          "required": [
            "mcp"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "license": {
            "enum": [
              "LicenseRef-Open-Government",
              "LicenseRef-Custom-Open",
              "LicenseRef-Research-Only"
            ]
          }
        },
        "required": [
          "license"
        ]
      },
      "then": {
        "required": [
          "license_url"
        ]
      }
    }
  ]
}
